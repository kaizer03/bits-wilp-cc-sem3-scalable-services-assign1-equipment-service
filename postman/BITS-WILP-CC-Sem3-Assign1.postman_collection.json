{
  "info": {
    "name": "BITS WILP CC Sem 3 Assign1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "26b383b6-4cb9-4765-a3e1-2cd36f480101",
    "description": "Resource Desk APIs grouped by owning service. Equipment and booking services use independent base addresses."
  },
  "variable": [
    {
      "key": "equipmentBaseUrl",
      "value": "http://127.0.0.1:14180"
    },
    {
      "key": "bookingBaseUrl",
      "value": "http://127.0.0.1:14181"
    },
    {
      "key": "equipmentId",
      "value": "58300000-0000-4000-8000-000000000001"
    },
    {
      "key": "registeredEquipmentId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "bookingDate",
      "value": ""
    },
    {
      "key": "requestKey",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"bookingDate\")) { const d=new Date(); d.setDate(d.getDate()+6); pm.collectionVariables.set(\"bookingDate\",d.toISOString().slice(0,10)); }",
          "if (pm.info.requestName === \"Create reservation\" || !pm.collectionVariables.get(\"requestKey\")) pm.collectionVariables.set(\"requestKey\",pm.variables.replaceIn(\"{{$guid}}\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Equipment Service",
      "item": [
        {
          "name": "Catalogue",
          "item": [
            {
              "name": "List equipment",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{equipmentBaseUrl}}/api/equipment"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Catalogue is available\", () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Equipment details",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{equipmentBaseUrl}}/api/equipment/{{equipmentId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Register equipment",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{equipmentBaseUrl}}/api/equipment",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"assetTag\": \"TEST-{{$timestamp}}\",\n  \"name\": \"Portable presentation screen\",\n  \"category\": \"Presentation\",\n  \"location\": \"Seminar room\",\n  \"description\": \"Portable screen for department meetings.\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                      "if (pm.response.code === 201) pm.collectionVariables.set(\"registeredEquipmentId\",pm.response.json().id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Mark equipment under maintenance",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{equipmentBaseUrl}}/api/equipment/{{registeredEquipmentId}}",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"maintenance\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Maintenance status\",()=>pm.expect(pm.response.json().status).to.eql(\"maintenance\"));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Restore equipment to operational",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{equipmentBaseUrl}}/api/equipment/{{registeredEquipmentId}}",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"operational\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Operational status\",()=>pm.expect(pm.response.json().status).to.eql(\"operational\"));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Health",
          "item": [
            {
              "name": "Equipment liveness",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{equipmentBaseUrl}}/health/live"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
