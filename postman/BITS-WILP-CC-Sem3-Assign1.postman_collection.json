                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"date\": \"2020-01-01\",\n  \"slot\": \"AM\",\n  \"requester\": \"Asha Sen\",\n  \"purpose\": \"Department review meeting\"\n}",
