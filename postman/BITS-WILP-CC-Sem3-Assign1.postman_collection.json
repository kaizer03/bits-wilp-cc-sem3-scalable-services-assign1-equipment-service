    },
    {
      "name": "Booking Service",
      "item": [
        {
          "name": "Reservations",
          "item": [
            {
              "name": "Create reservation",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "{{requestKey}}"
                  }
                ],
                "url": "{{bookingBaseUrl}}/api/bookings",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"date\": \"{{bookingDate}}\",\n  \"slot\": \"AM\",\n  \"requester\": \"Asha Sen\",\n  \"purpose\": \"Department review meeting\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Reservation created or replayed\", () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                      "if ([200,201].includes(pm.response.code)) pm.collectionVariables.set(\"bookingId\",pm.response.json().id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Read reservation",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{bookingBaseUrl}}/api/bookings/{{bookingId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List reservations",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{bookingBaseUrl}}/api/bookings"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Reservation list\",()=>pm.expect(pm.response.json()).to.be.an(\"array\"));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List reservations by date",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{bookingBaseUrl}}/api/bookings?date={{bookingDate}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Reservation list\",()=>pm.expect(pm.response.json()).to.be.an(\"array\"));"
                    ]
                  }
                }
              ]
            }
          ]
        },
