                "url": "{{equipmentBaseUrl}}/health/ready"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
