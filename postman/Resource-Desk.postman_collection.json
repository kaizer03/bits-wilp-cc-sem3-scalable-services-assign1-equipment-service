{
  "info": {
    "name": "Resource Desk",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:14180"
    },
    {
      "key": "equipmentId",
      "value": "58300000-0000-4000-8000-000000000001"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "bookingDate",
      "value": ""
    },
    {
      "key": "requestKey",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"bookingDate\")) { const d=new Date(); d.setDate(d.getDate()+5); pm.collectionVariables.set(\"bookingDate\",d.toISOString().slice(0,10)); }",
          "if (pm.info.requestName === \"Create reservation\" || !pm.collectionVariables.get(\"requestKey\")) pm.collectionVariables.set(\"requestKey\",pm.variables.replaceIn(\"{{$guid}}\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "List equipment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/equipment"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Catalogue is available\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Equipment details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
      },
      "event": []
    },
    {
      "name": "Create reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{requestKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"date\": \"{{bookingDate}}\",\n  \"slot\": \"AM\",\n  \"requester\": \"Asha Sen\",\n  \"purpose\": \"Department review meeting\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reservation created or replayed\", () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "if ([200,201].includes(pm.response.code)) pm.collectionVariables.set(\"bookingId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{requestKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"date\": \"{{bookingDate}}\",\n  \"slot\": \"AM\",\n  \"requester\": \"Asha Sen\",\n  \"purpose\": \"Department review meeting\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Same reservation returned\", () => pm.response.to.have.status(200));",
              "pm.test(\"Replay header\",()=>pm.expect(pm.response.headers.get(\"Idempotency-Replayed\")).to.eql(\"true\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Competing reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"date\": \"{{bookingDate}}\",\n  \"slot\": \"AM\",\n  \"requester\": \"Ravi Das\",\n  \"purpose\": \"Department review meeting\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Slot conflict\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read reservation",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
      },
      "event": []
    },
    {
      "name": "Availability",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/availability?date={{bookingDate}}"
      },
      "event": []
    },
    {
      "name": "Cancel reservation",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reservation cancelled\",()=>pm.expect(pm.response.json().status).to.eql(\"cancelled\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Maintenance rejection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"58300000-0000-4000-8000-000000000004\",\n  \"date\": \"{{bookingDate}}\",\n  \"slot\": \"AM\",\n  \"requester\": \"Asha Sen\",\n  \"purpose\": \"Department review meeting\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Maintenance blocks reservation\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    }
  ]
}
